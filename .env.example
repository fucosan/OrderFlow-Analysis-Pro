# ── Telegram Bot ──
# Create a bot via @BotFather to get a token.
# Get your chat ID via @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── MT5 Credentials (optional, only if using MT5 feed) ──
# MT5_LOGIN=
# MT5_PASSWORD=
# MT5_SERVER=

# ── MT5 Automatic Execution (optional, OFF by default) ──
# Set to 1 to let the system PLACE REAL ORDERS in MT5 automatically when an
# entry/exit signal fires. Keep DISABLED (0/unset) until you've validated the
# signals on a demo/paper account.
# IMPORTANT: MT5 itself must run with "Algo Trading" enabled in the terminal.
# MT5_AUTO_TRADE=0

# ── Per-instrument auto-trade allowlist (optional) ──
# Even with MT5_AUTO_TRADE=1, only symbols whose config sets risk.auto_trade=True
# (in config/settings.py) are auto-traded. This env var is an ADDITIONAL filter
# that overrides which instruments are allowed (comma-separated internal names).
# Eg: only auto-trade BTC:
# MT5_AUTO_TRADE_SYMBOLS=BTCUSDT

# ── IB Gateway (optional, only if using IB feed) ──
# Point at your locally running IB Gateway / TWS.
#   IB Gateway: port 4002 (paper) / 4001 (live)
#   TWS:        port 7497 (paper) / 7496 (live)
# IB_HOST=127.0.0.1
# IB_PORT=4002
# IB_CLIENT_ID=1
